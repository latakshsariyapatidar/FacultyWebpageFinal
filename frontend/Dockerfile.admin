# ============================================
# Admin Panel - Dockerfile
# Lightweight Express server for admin.html
# ============================================

FROM node:20-alpine

WORKDIR /app

# Install only express (the sole dependency)
RUN npm init -y && npm install express@5

# Copy admin panel files
COPY admin.html admin-server.js admin.js ./

# Expose admin port
EXPOSE 7997

# Start admin server
CMD ["node", "admin-server.js"]
