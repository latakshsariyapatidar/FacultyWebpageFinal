# Environment variables for Docker deployment
# Copy this file to .env for production use

# ===== Frontend Configuration =====
REACT_APP_API_URL=https://faculty.iitdh.ac.in/api
REACT_APP_ADMIN_URL=https://faculty.iitdh.ac.in/admin

# ===== Backend Configuration =====
NODE_ENV=production
API_PORT=8000
API_HOST=0.0.0.0

# Database/Data configuration (if applicable)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=faculty_db
# DB_USER=admin
# DB_PASSWORD=secure_password

# Google Sheets Integration (if using googleSheetsService.js)
# GOOGLE_SHEETS_API_KEY=your_api_key_here
# GOOGLE_SHEETS_ID=your_sheet_id_here

# Authentication (if needed)
# JWT_SECRET=your_jwt_secret_here
# SESSION_SECRET=your_session_secret_here

# ===== Admin Panel Configuration =====
ADMIN_PORT=7997
ADMIN_HOST=0.0.0.0

# ===== Docker Compose Configuration =====
COMPOSE_PROJECT_NAME=faculty-website
COMPOSE_FILE=docker-compose.yml

# ===== Logging =====
LOG_LEVEL=info

# ===== CORS Settings =====
CORS_ORIGIN=https://faculty.iitdh.ac.in
